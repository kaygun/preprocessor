#!/bin/bash

# Determine directory where mlisp and companion scripts reside
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLACE="${SCRIPT_DIR}"
if [ ! -f "$PLACE/markdown.lisp" ] && [ -d "${HOME}/local/lib" ]; then
    PLACE="${HOME}/local/lib"
fi

# Check for --watch or -w flag
WATCH_MODE=0
if [ "$1" = "--watch" ] || [ "$1" = "-w" ]; then
    WATCH_MODE=1
    shift
fi

if [ -z "$1" ]; then
    echo "Usage: mlisp [--watch] <file.mlsp|msc|mpy|mclj|msage> [title]"
    echo "   or: mlisp <extension> <name> [title]"
    exit 1
fi

# Support both `mlisp <file> [title]` and `mlisp <ext> <name> [title]`
if [ -f "$1" ]; then
    filename="$1"
    title="$2"
    extension="${filename##*.}"
    name="${filename%.*}"
elif [ -n "$2" ] && [ -f "$2.$1" ]; then
    extension="$1"
    name="$2"
    title="$3"
    filename="$name.$extension"
else
    filename="$1"
    title="$2"
    extension="${filename##*.}"
    name="${filename%.*}"
fi

process_once() {
    echo "Processing $name with extension $extension"

    [ -f "$name.html" ] && rm -f "$name.html"
    [ -f "$name.md" ]   && rm -f "$name.md"

    case "$extension" in
        mlsp)
            echo "A Common Lisp file! Evaluating..."
            sbcl --noinform --script "$PLACE/markdown.lisp" "$name.mlsp" "$name.md"
            ;;
        msc)
            echo "A Scala file! Evaluating..."
            if [ -f "$PLACE/markdown.scala" ]; then
                scala "$PLACE/markdown.scala" "$name.msc" "$name.md"
            elif [ -f "$PLACE/markdown.sc" ]; then
                scala "$PLACE/markdown.sc" "$name.msc" > "$name.md"
            fi
            ;;
        mpy)
            echo "A Python file! Evaluating..."
            python3 "$PLACE/markdown.py" "$name.mpy" "$name.md"
            ;;
        msage)
            echo "A SageMath file! Evaluating..."
            if [ -f "/home/kaygun/local/venv/bin/activate" ]; then
                source /home/kaygun/local/venv/bin/activate
            fi
            sage "$PLACE/markdown.sage" "$name.msage" "$name.md"
            ;;
        mclj)
            echo "A Clojure file! Evaluating..."
            clj -M "$PLACE/markdown.clj" "$name.mclj" "$name.md"
            ;;
        *)
            echo "Unsupported extension: .$extension"
            return 1
            ;;
    esac

    if [ -f "$name.md" ]; then
        # Append footer with timestamp BEFORE pandoc conversion so it is included in HTML
        echo -e "\n\n::: {#footer}" >> "$name.md"
        echo "[" "$(date +'%B %d, %Y %r')" "]{#timestamp}" >> "$name.md"
        echo ":::" >> "$name.md"

        css_args=()
        if [ -f "$PLACE/mlisp.css" ]; then
            css_args=(--css "$PLACE/mlisp.css")
        elif [ -f "./mlisp.css" ]; then
            css_args=(--css "./mlisp.css")
        fi

        pandoc -s -f markdown -t html --mathjax --highlight-style=tango \
               "${css_args[@]}" --metadata title="$title" \
               -o "$name.html" "$name.md"

        cat "$name.md"
    else
        echo "Error: Processing did not produce $name.md"
        return 1
    fi
}

if [ "$WATCH_MODE" -eq 1 ]; then
    echo "Watching $filename for changes (Ctrl+C to stop)..."
    process_once
    last_mod=""
    while true; do
        current_mod=$(stat -c %Y "$filename" 2>/dev/null)
        if [ "$current_mod" != "$last_mod" ]; then
            last_mod="$current_mod"
            echo "File changed at $(date +'%T'). Recompiling..."
            process_once
        fi
        sleep 2
    done
else
    process_once
fi
